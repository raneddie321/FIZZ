{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "builds": [
    {
      "src": "static-site/**",
      "use": "@vercel/static"
    },
    {
      "src": "api/**/*.mjs",
      "use": "@vercel/node",
      "config": {
        "maxDuration": 60
      }
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "headers": {
        "X-Content-Type-Options": "nosniff",
        "Referrer-Policy": "strict-origin-when-cross-origin",
        "X-Frame-Options": "SAMEORIGIN"
      },
      "continue": true
    },
    {
      "src": "/api/oauth/([^/]+)/([^/]+)",
      "dest": "/api/oauth/[provider]/[action].mjs?provider=$1&action=$2"
    },
    {
      "src": "/api/github/([^/]+)",
      "dest": "/api/github/[action].mjs?action=$1"
    },
    {
      "src": "/api/vercel/([^/]+)",
      "dest": "/api/vercel/[action].mjs?action=$1"
    },
    {
      "src": "/api/status",
      "dest": "/api/status.mjs"
    },
    {
      "src": "/api/ai/chat",
      "dest": "/api/ai/chat.mjs"
    },
    {
      "src": "/api/(.*)",
      "status": 404,
      "dest": "/static-site/404.html"
    },
    {
      "src": "/",
      "dest": "/static-site/index.html"
    },
    {
      "src": "/(.*)",
      "dest": "/static-site/$1"
    },
    {
      "handle": "error"
    },
    {
      "src": "/(.*)",
      "status": 404,
      "dest": "/static-site/404.html"
    }
  ]
}
