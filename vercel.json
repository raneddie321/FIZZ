{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "builds": [
    {
      "src": "static-site/**",
      "use": "@vercel/static"
    },
    {
      "src": "api/**/*.mjs",
      "use": "@vercel/node",
      "config": {
        "maxDuration": 60
      }
    }
  ],
  "routes": [
    {
      "src": "/(?!api/)(.*)",
      "has": [
        {
          "type": "host",
          "value": "fizzbrowser.vercel.app"
        }
      ],
      "status": 308,
      "headers": {
        "Location": "https://fizz.raneddie.com/$1"
      }
    },
    {
      "src": "/(.*)",
      "headers": {
        "X-Content-Type-Options": "nosniff",
        "Referrer-Policy": "strict-origin-when-cross-origin",
        "X-Frame-Options": "SAMEORIGIN",
        "Strict-Transport-Security": "max-age=63072000",
        "Permissions-Policy": "camera=(self), microphone=(self), geolocation=(self), payment=(), usb=(), serial=(), bluetooth=(), hid=(), interest-cohort=()",
        "Cross-Origin-Opener-Policy": "same-origin-allow-popups",
        "Content-Security-Policy": "object-src 'none'; base-uri 'self'; frame-ancestors 'self'; upgrade-insecure-requests",
        "X-Permitted-Cross-Domain-Policies": "none"
      },
      "continue": true
    },
    {
      "src": "/api/(.*)",
      "headers": {
        "Cache-Control": "no-store",
        "X-Robots-Tag": "noindex"
      },
      "continue": true
    },
    {
      "src": "/api/oauth/([^/]+)/([^/]+)",
      "dest": "/api/oauth/[provider]/[action].mjs?provider=$1&action=$2"
    },
    {
      "src": "/api/connector/([^/]+)/([^/]+)",
      "dest": "/api/connector/[service]/[action].mjs?service=$1&action=$2"
    },
    {
      "src": "/api/github/([^/]+)",
      "dest": "/api/github/[action].mjs?action=$1"
    },
    {
      "src": "/api/vercel/([^/]+)",
      "dest": "/api/vercel/[action].mjs?action=$1"
    },
    {
      "src": "/api/status",
      "dest": "/api/status.mjs"
    },
    {
      "src": "/api/account",
      "dest": "/api/account.mjs"
    },
    {
      "src": "/api/sync",
      "dest": "/api/sync.mjs"
    },
    {
      "src": "/api/browser",
      "dest": "/api/browser.mjs"
    },
    {
      "src": "/api/sandbox",
      "dest": "/api/sandbox.mjs"
    },
    {
      "src": "/api/web/([^/]+)",
      "dest": "/api/web/[action].mjs?action=$1"
    },
    {
      "src": "/api/mcp/([^/]+)",
      "dest": "/api/web/[action].mjs?action=mcp-$1"
    },
    {
      "src": "/api/email-taken",
      "dest": "/api/email-taken.mjs"
    },
    {
      "src": "/api/ai/chat",
      "dest": "/api/ai/chat.mjs"
    },
    {
      "src": "/api/(.*)",
      "status": 404,
      "dest": "/static-site/404.html"
    },
    {
      "src": "/",
      "dest": "/static-site/index.html"
    },
    {
      "src": "/(.*)",
      "dest": "/static-site/$1"
    },
    {
      "handle": "error"
    },
    {
      "src": "/(.*)",
      "status": 404,
      "dest": "/static-site/404.html"
    }
  ]
}
